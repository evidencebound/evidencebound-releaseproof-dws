{
  "schema_version": 1,
  "repository": "evidencebound/evidencebound-releaseproof-dws",
  "policy": {
    "development": "required",
    "frozen": "audit"
  },
  "bootstrap": [
    {
      "id": "install-dev",
      "command": "python -m pip install -e '.[dev]'",
      "timeout_seconds": 900
    }
  ],
  "suites": [
    {
      "id": "deterministic-tests",
      "phase": "development",
      "command": "python -m pytest -q",
      "hard_gate": true,
      "timeout_seconds": 1200
    },
    {
      "id": "releaseproof-evaluation",
      "phase": "development",
      "command": "python scripts/run_evaluation.py",
      "hard_gate": true,
      "timeout_seconds": 300
    }
  ],
  "freeze": {
    "enabled": false
  }
}
